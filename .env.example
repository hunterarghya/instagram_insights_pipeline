# Database (this is for my docker setup, use this as default if using the docker setup, else plug in real ones)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=insta_db
DB_USER=postgres
DB_PASS=postgres
DB_SCHEMA=insta
DB_SSLMODE=disable

# Dummy mode: set to 1 to use dummy API responses, 0 to hit real Instagram APIs
DUMMY_SWITCH=1

IG_ACCOUNT_ID=x          # the Instagram professional (business) account id
IG_ACCESS_TOKEN=x        # long-lived access token (Facebook/Instagram user token)
GRAPH_API_VERSION=v25.0
GRAPH_BASE_URL=https://graph.facebook.com